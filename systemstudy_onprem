-- Query to check Database Backups Details

SELECT @command = 'USE ? 

SELECT TOP (10) bs.machine_name, bs.server_name, bs.database_name AS [Database Name], bs.recovery_model,bs.[type],
CONVERT (BIGINT, bs.backup_size / 1048576 ) AS [Uncompressed Backup Size (MB)],
CONVERT (BIGINT, bs.compressed_backup_size / 1048576 ) AS [Compressed Backup Size (MB)],
CONVERT (NUMERIC (20,2), (CONVERT (FLOAT, bs.backup_size) /
CONVERT (FLOAT, bs.compressed_backup_size))) AS [Compression Ratio], bs.has_backup_checksums, bs.is_copy_only, bs.encryptor_type,
DATEDIFF (SECOND, bs.backup_start_date, bs.backup_finish_date) AS [Backup Elapsed Time (sec)],
bs.backup_finish_date AS [Backup Finish Date], bmf.physical_device_name AS [Backup Location], bmf.physical_block_size
FROM msdb.dbo.backupset AS bs WITH (NOLOCK)
INNER JOIN msdb.dbo.backupmediafamily AS bmf WITH (NOLOCK)
ON bs.media_set_id = bmf.media_set_id  
WHERE bs.database_name = DB_NAME(DB_ID())
AND bs.[type] in( ''D'',''I'',''L'') 
ORDER BY bs.backup_finish_date DESC OPTION (RECOMPILE);'

EXEC sp_MSforeachdb @command 

SELECT @command = 'USE ? 

SELECT  @@servername as ServerName,DB_NAME() AS CurrentDatabase,
    sk.name AS SymmetricKeyName,
    sk.symmetric_key_id,
    sk.algorithm_desc AS AlgorithmType,
    sk.key_length AS KeyLength,
    ke.crypt_type_desc AS ProtectorType,
    CASE 
        WHEN ke.crypt_type_desc = ''CERTIFICATE'' THEN certs.name
        WHEN ke.crypt_type_desc = ''ASYMMETRIC KEY'' THEN asym.name
        WHEN ke.crypt_type_desc = ''DATABASE MASTER KEY'' THEN ''Database Master Key''
        WHEN ke.crypt_type_desc = ''SERVICE MASTER KEY'' THEN ''Service Master Key''
        WHEN ke.crypt_type_desc = ''PASSWORD'' THEN ''Password''
        ELSE ''Unknown''
    END AS ProtectorName,
    sk.create_date,
    sk.modify_date
FROM sys.symmetric_keys sk
LEFT JOIN sys.key_encryptions ke 
    ON sk.symmetric_key_id = ke.key_id
LEFT JOIN sys.certificates certs 
    ON ke.crypt_property = certs.thumbprint
LEFT JOIN sys.asymmetric_keys asym 
    ON ke.crypt_property = asym.thumbprint
ORDER BY sk.name;'

EXEC sp_MSforeachdb @command

